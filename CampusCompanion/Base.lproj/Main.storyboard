<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24412" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="nav-001">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24405"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Navigation Controller-->
        <scene sceneID="nav-scene">
            <objects>
                <navigationController id="nav-001" sceneMemberID="viewController">
                    <navigationBar key="navigationBar" contentMode="scaleToFill" id="nav-bar">
                        <rect key="frame" x="0.0" y="118" width="393" height="54"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </navigationBar>
                    <connections>
                        <segue destination="welcome-001" kind="relationship" relationship="rootViewController" id="nav-root"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="nav-first" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="51" y="-655"/>
        </scene>
        <!--View Controller-->
        <scene sceneID="welcome-scene">
            <objects>
                <viewController id="welcome-001" customClass="ViewController" customModule="CampusCompanion" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="welcome-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="figure.hiking" catalog="system" translatesAutoresizingMaskIntoConstraints="NO" id="welcome-image">
                                <rect key="frame" x="121.66666666666669" y="211.66666666666663" width="150" height="121.33333333333337"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="120" id="image-height"/>
                                    <constraint firstAttribute="width" constant="150" id="image-width"/>
                                </constraints>
                            </imageView>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Campus Companion" textAlignment="center" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="welcome-title">
                                <rect key="frame" x="20" y="352" width="353" height="34"/>
                                <fontDescription key="fontDescription" type="boldSystem" pointSize="28"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Your Campus, In Your Pocket" textAlignment="center" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="welcome-subtitle">
                                <rect key="frame" x="20" y="394" width="353" height="20"/>
                                <fontDescription key="fontDescription" type="system" pointSize="16"/>
                            </label>
                            <textField opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" borderStyle="roundedRect" placeholder="Enter your name" translatesAutoresizingMaskIntoConstraints="NO" id="name-field">
                                <rect key="frame" x="32" y="438" width="329" height="34"/>
                                <fontDescription key="fontDescription" type="system" pointSize="12"/>
                                <textInputTraits key="textInputTraits"/>
                            </textField>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Notify me about events" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="notify-label">
                                <rect key="frame" x="32" y="488" width="177" height="20"/>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                            </label>
                            <switch opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="notify-switch">
                                <rect key="frame" x="300" y="484" width="63" height="28"/>
                            </switch>
                            <segmentedControl opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" segmentControlStyle="plain" translatesAutoresizingMaskIntoConstraints="NO" id="role-segment">
                                <rect key="frame" x="32" y="524" width="329" height="32"/>
                                <segments>
                                    <segment title="Student"/>
                                    <segment title="Faculty"/>
                                </segments>
                            </segmentedControl>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Event Date" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="date-label">
                                <rect key="frame" x="32" y="571" width="83" height="21"/>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                            </label>
                            <datePicker opaque="NO" contentMode="scaleToFill" ambiguous="YES" contentHorizontalAlignment="center" contentVerticalAlignment="center" datePickerMode="dateAndTime" translatesAutoresizingMaskIntoConstraints="NO" id="event-date">
                                <rect key="frame" x="259" y="563.66666666666663" width="102" height="36"/>
                            </datePicker>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Guests: 1" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="guest-label">
                                <rect key="frame" x="32" y="608" width="70" height="20"/>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                            </label>
                            <stepper opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" value="1" minimumValue="1" maximumValue="10" translatesAutoresizingMaskIntoConstraints="NO" id="guest-stepper">
                                <rect key="frame" x="267" y="602" width="94" height="32"/>
                                <connections>
                                    <action selector="guestStepperChanged:" destination="welcome-001" eventType="valueChanged" id="guest-action"/>
                                </connections>
                            </stepper>
                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="explore-button">
                                <rect key="frame" x="122.66666666666669" y="652" width="148" height="35"/>
                                <buttonConfiguration key="configuration" style="filled" title="Explore Campus"/>
                                <connections>
                                    <action selector="exploreButtonTapped:" destination="welcome-001" eventType="touchUpInside" id="explore-action"/>
                                </connections>
                            </button>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="welcome-safe"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="welcome-image" firstAttribute="top" secondItem="welcome-safe" secondAttribute="top" constant="40" id="c1"/>
                            <constraint firstItem="name-field" firstAttribute="leading" secondItem="welcome-safe" secondAttribute="leading" constant="32" id="c10"/>
                            <constraint firstItem="name-field" firstAttribute="trailing" secondItem="welcome-safe" secondAttribute="trailing" constant="-32" id="c11"/>
                            <constraint firstItem="notify-label" firstAttribute="top" secondItem="name-field" secondAttribute="bottom" constant="16" id="c12"/>
                            <constraint firstItem="notify-label" firstAttribute="leading" secondItem="name-field" secondAttribute="leading" id="c13"/>
                            <constraint firstItem="notify-switch" firstAttribute="centerY" secondItem="notify-label" secondAttribute="centerY" id="c14"/>
                            <constraint firstItem="notify-switch" firstAttribute="trailing" secondItem="name-field" secondAttribute="trailing" id="c15"/>
                            <constraint firstItem="role-segment" firstAttribute="top" secondItem="notify-label" secondAttribute="bottom" constant="16" id="c16"/>
                            <constraint firstItem="role-segment" firstAttribute="leading" secondItem="name-field" secondAttribute="leading" id="c17"/>
                            <constraint firstItem="role-segment" firstAttribute="trailing" secondItem="name-field" secondAttribute="trailing" id="c18"/>
                            <constraint firstItem="date-label" firstAttribute="top" secondItem="role-segment" secondAttribute="bottom" constant="16" id="c19"/>
                            <constraint firstItem="welcome-image" firstAttribute="centerX" secondItem="welcome-safe" secondAttribute="centerX" id="c2"/>
                            <constraint firstItem="date-label" firstAttribute="leading" secondItem="name-field" secondAttribute="leading" id="c20"/>
                            <constraint firstItem="event-date" firstAttribute="centerY" secondItem="date-label" secondAttribute="centerY" id="c21"/>
                            <constraint firstItem="event-date" firstAttribute="trailing" secondItem="name-field" secondAttribute="trailing" id="c22"/>
                            <constraint firstItem="guest-label" firstAttribute="top" secondItem="date-label" secondAttribute="bottom" constant="16" id="c23"/>
                            <constraint firstItem="guest-label" firstAttribute="leading" secondItem="name-field" secondAttribute="leading" id="c24"/>
                            <constraint firstItem="guest-stepper" firstAttribute="centerY" secondItem="guest-label" secondAttribute="centerY" id="c25"/>
                            <constraint firstItem="guest-stepper" firstAttribute="trailing" secondItem="name-field" secondAttribute="trailing" id="c26"/>
                            <constraint firstItem="explore-button" firstAttribute="top" secondItem="guest-label" secondAttribute="bottom" constant="24" id="c27"/>
                            <constraint firstItem="explore-button" firstAttribute="centerX" secondItem="welcome-safe" secondAttribute="centerX" id="c28"/>
                            <constraint firstItem="welcome-title" firstAttribute="top" secondItem="welcome-image" secondAttribute="bottom" constant="20" id="c3"/>
                            <constraint firstItem="welcome-title" firstAttribute="leading" secondItem="welcome-safe" secondAttribute="leading" constant="20" id="c4"/>
                            <constraint firstItem="welcome-title" firstAttribute="trailing" secondItem="welcome-safe" secondAttribute="trailing" constant="-20" id="c5"/>
                            <constraint firstItem="welcome-subtitle" firstAttribute="top" secondItem="welcome-title" secondAttribute="bottom" constant="8" id="c6"/>
                            <constraint firstItem="welcome-subtitle" firstAttribute="leading" secondItem="welcome-safe" secondAttribute="leading" constant="20" id="c7"/>
                            <constraint firstItem="welcome-subtitle" firstAttribute="trailing" secondItem="welcome-safe" secondAttribute="trailing" constant="-20" id="c8"/>
                            <constraint firstItem="name-field" firstAttribute="top" secondItem="welcome-subtitle" secondAttribute="bottom" constant="24" id="c9"/>
                        </constraints>
                    </view>
                    <connections>
                        <outlet property="eventDatePicker" destination="event-date" id="out-date"/>
                        <outlet property="guestCountLabel" destination="guest-label" id="out-guest-label"/>
                        <outlet property="guestStepper" destination="guest-stepper" id="out-stepper"/>
                        <outlet property="nameTextField" destination="name-field" id="out-name"/>
                        <outlet property="notifySwitch" destination="notify-switch" id="out-switch"/>
                        <outlet property="roleSegmentedControl" destination="role-segment" id="out-role"/>
                        <outlet property="subtitleLabel" destination="welcome-subtitle" id="out-subtitle"/>
                        <outlet property="titleLabel" destination="welcome-title" id="out-title"/>
                        <segue destination="detail-001" kind="show" identifier="ShowDetailSegue" id="detail-segue"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="welcome-first" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="51" y="22"/>
        </scene>
        <!--Detail View Controller-->
        <scene sceneID="detail-scene">
            <objects>
                <viewController id="detail-001" customClass="DetailViewController" customModule="CampusCompanion" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="detail-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="message-label">
                                <rect key="frame" x="32" y="478" width="329" height="0.0"/>
                                <fontDescription key="fontDescription" type="system" pointSize="20"/>
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="detail-safe"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="message-label" firstAttribute="centerX" secondItem="detail-safe" secondAttribute="centerX" id="d1"/>
                            <constraint firstItem="message-label" firstAttribute="centerY" secondItem="detail-safe" secondAttribute="centerY" id="d2"/>
                            <constraint firstItem="message-label" firstAttribute="leading" secondItem="detail-safe" secondAttribute="leading" constant="32" id="d3"/>
                            <constraint firstItem="message-label" firstAttribute="trailing" secondItem="detail-safe" secondAttribute="trailing" constant="-32" id="d4"/>
                        </constraints>
                    </view>
                    <connections>
                        <outlet property="messageLabel" destination="message-label" id="out-message"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="detail-first" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="720" y="-98"/>
        </scene>
    </scenes>
    <resources>
        <image name="figure.hiking" catalog="system" width="96" height="128"/>
        <systemColor name="systemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
    </resources>
</document>
